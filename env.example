# Base URL the browser uses to reach the API. Baked into the client bundle at build time.
# Local dev (backend running directly on 3001): http://localhost:3001
# Docker Compose (behind nginx, see ../nginx/default.conf):        http://localhost/api
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Cloud Translate API key, used server-side by /api/translate
# to auto-translate product name/description on product creation.
GOOGLE_TRANSLATE_API_KEY=change_this_to_a_real_key
